{
  "name": "zcusclaw-addon-qa-matrix",
  "version": "2026.6.2",
  "description": "OpenClaw Matrix QA runner plugin",
  "type": "module",
  "dependencies": {
    "undici": "8.3.0"
  },
  "devDependencies": {
    "@openclaw/matrix": "workspace:*",
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "2026.5.28"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.6.2"
    },
    "release": {
      "publishToNpm": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}

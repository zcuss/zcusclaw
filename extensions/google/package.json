{
  "name": "zcusclaw-plugin-google",
  "version": "2026.6.2",
  "description": "OpenClaw Google plugin",
  "type": "module",
  "dependencies": {
    "@google/genai": "2.7.0",
    "google-auth-library": "10.6.2"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "release": {
      "publishToNpm": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
